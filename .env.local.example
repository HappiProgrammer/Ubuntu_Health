# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# MTN MoMo API
MOMO_API_KEY=your_momo_api_key
MOMO_API_SECRET=your_momo_api_secret
MOMO_ENVIRONMENT=sandbox

# HuggingFace API (for sentiment analysis)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_32_character_encryption_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CareTaker

# ==========================================
# CAMEROON MOBILE MONEY (MTN MOMO & ORANGE MONEY)
# ==========================================
# MTN MoMo Developer API (https://momodeveloper.mtn.com)
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_API_USER=your_mtn_api_user_uuid
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_CALLBACK_URL=http://localhost:3000/api/payments/callback?provider=mtn

# Orange Money Developer API (https://developer.orange.com)
ORANGE_MONEY_ENVIRONMENT=sandbox
ORANGE_MONEY_CLIENT_ID=your_orange_client_id
ORANGE_MONEY_CLIENT_SECRET=your_orange_client_secret
ORANGE_MONEY_MERCHANT_KEY=your_orange_merchant_key
